APP_NAME=AI Try-On API
DEBUG=false
APP_ENV=local

# Thay đổi pass và tên db nếu cần
DATABASE_URL=postgresql+psycopg2://postgres:161202@localhost:5432/AITryOn
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Kling Kolors Virtual Try-On. Keep these values backend-only.
# To enable real Kolors calls, set AI_PROVIDER=kling_kolors and fill both keys.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_VTON_MODEL=kolors-virtual-try-on-v1-5
# Optional webhook URL if you later implement callback handling.
KLING_CALLBACK_URL=
KLING_TIMEOUT_SECONDS=60


#AI_PROVIDER=kling_kolors
#KLING_ACCESS_KEY=access_key_ban_nhan_tu_kling
#KLING_SECRET_KEY=secret_key_ban_nhan_tu_kling
